{
  "uid": "arda-kubernetes",
  "title": "Arda Kubernetes / Nodes",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes ready",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [ { "refId": "A", "expr": "count(kube_node_status_condition{condition=\"Ready\", status=\"true\"})", "legendFormat": "ready" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pods running",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [ { "refId": "A", "expr": "count(kube_pod_status_phase{phase=\"Running\"} == 1)", "legendFormat": "running" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pods not ready",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [ { "refId": "A", "expr": "count(kube_pod_status_ready{condition=\"false\"} == 1)", "legendFormat": "not ready" } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Container restarts (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"arda-app|monitoring\"}[1h])) or vector(0)", "legendFormat": "restarts" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Node CPU usage %",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100)", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node memory usage %",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Node root filesystem used %",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 85 } ] } }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Top 10 CPU by pod (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\", container!=\"POD\", image!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Top 10 memory by pod (working set)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (namespace, pod) (container_memory_working_set_bytes{container!=\"\", container!=\"POD\", image!=\"\"}))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Restarts by pod (1h)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"arda-app|monitoring\"}[1h])) > 0",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Pods by phase",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [ { "refId": "A", "expr": "count by (phase) (kube_pod_status_phase == 1)", "legendFormat": "{{phase}}" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Node network receive B/s",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|cali.*|flannel.*|cni0|docker0\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Pods whose last termination was OOMKilled",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"} == 1", "instant": true, "format": "table" }
      ],
      "options": { "showHeader": true }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Deployments with unavailable replicas",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "kube_deployment_status_replicas_unavailable > 0", "instant": true, "format": "table" }
      ],
      "options": { "showHeader": true }
    }
  ]
}
