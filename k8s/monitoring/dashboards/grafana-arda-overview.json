{
  "uid": "arda-overview",
  "title": "Arda Overview",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services up (expect 15)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [{ "refId": "A", "expr": "count(up)", "legendFormat": "up" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests/s by service",
      "gridPos": { "h": 8, "w": 20, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (rate(arda_http_requests_total[5m]))", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx/s by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (rate(arda_http_responses_total{class=\"5xx\"}[5m]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP p95 by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(arda_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI runs (1h) by status",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (increase(arda_ai_runs_total[1h]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "AI tokens (1h) by type",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (increase(arda_ai_llm_tokens_total[1h]))", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Model TTFT p95 and model duration p95",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(arda_ai_model_ttft_seconds_bucket[15m])))",
          "legendFormat": "ttft p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(arda_ai_model_duration_seconds_bucket[15m])))",
          "legendFormat": "duration p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retrieval: embedding p95 (s) and prompt size p95 (bytes)",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(arda_ai_retrieval_embed_seconds_bucket[30m])))",
          "legendFormat": "embed p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(arda_ai_prompt_bytes_bucket[1h])))",
          "legendFormat": "prompt p95 (bytes)"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Event publish failures (1h)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(arda_ai_event_publish_failures_total[1h])) or vector(0)",
          "legendFormat": "failures"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    }
  ]
}
