# ARDA Platform bootstrap config
# Only for namespace: platform
# Hydra/Kratos belong to namespace auth and are intentionally not included here.

NAMESPACE=platform

# Component switches
INSTALL_CILIUM=true
INSTALL_NATS=true
INSTALL_VALKEY=true
INSTALL_GARAGE=true
INSTALL_CLOUDFLARED=true

# CNI
# Cilium replaces the embedded Flannel VXLAN fabric. Flannel does not implement
# the NetworkPolicy API, so every policy in this cluster was a no-op until this
# was installed. Runbook and rollback: docs/cni-migration.md
CILIUM_RELEASE=cilium
CILIUM_CHART_VERSION=1.20.2
# install-cilium.sh refuses to run when the live node count does not match this,
# because a partial agent rollout leaves those nodes with no datapath at all.
CILIUM_EXPECTED_NODES=3

# LAN VIPs (L2/ARP). Own namespace: the speaker needs hostNetwork and
# NET_RAW, which the platform namespace does not grant. Pool and address list:
# manifests/metallb/pool.yaml
INSTALL_METALLB=true
METALLB_RELEASE=metallb
METALLB_NAMESPACE=metallb-system
METALLB_CHART_VERSION=0.16.1

# Zeebe 8.5 is used to match Arda's Zeebe client and avoid Camunda 8.6+ production license requirements.
INSTALL_ZEEBE=true

# Helm release names
NATS_RELEASE=nats
VALKEY_RELEASE=valkey
GARAGE_RELEASE=garage
ZEEBE_RELEASE=zeebe
ZEEBE_CHART_VERSION=10.11.3

# Garage
GARAGE_BUCKET=media
GARAGE_REGION=garage
GARAGE_S3_HOST=s3.arda.io.vn
GARAGE_WEBUI_HOST=garage-ui.arda.io.vn

# NodePorts
NATS_NODEPORT=30222
VALKEY_NODEPORT=30379
VALKEY_SENTINEL_NODEPORT=30380
ZEEBE_GRPC_NODEPORT=30650
ZEEBE_REST_NODEPORT=30080
ZEEBE_METRICS_NODEPORT=30960

# Storage
DEFAULT_STORAGE_CLASS=local-path
