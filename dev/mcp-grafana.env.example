# Credentials for the read-only Grafana MCP used by dev agents.
# Copy to dev/mcp-grafana.env (gitignored) and fill in the service account token:
# Grafana -> Administration -> Users and access -> Service accounts -> mcp-dev -> Add token.
GRAFANA_URL=https://grafana.arda.io.vn
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxx

# Only needed if grafana.arda.io.vn is ever placed behind Cloudflare Access:
# create an Access service token (Zero Trust -> Access -> Service Auth) and
# uncomment.
# GRAFANA_EXTRA_HEADERS={"CF-Access-Client-Id":"<id>.access","CF-Access-Client-Secret":"<secret>"}
