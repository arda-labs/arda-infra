# Credentials for the read-only Postgres MCP used by dev agents.
# Copy to dev/mcp-postgres.env (gitignored) and fill in the password of the
# read-only role `arda_agent_ro`.
#
# Provisioning / rotation SQL (run as superuser on the CNPG primary, e.g.
# `kubectl -n database exec -i pg-main-1 -c postgres -- psql -U postgres -d postgres`):
#
#   CREATE ROLE arda_agent_ro WITH LOGIN PASSWORD '<password>';   -- or ALTER ROLE ... PASSWORD
#   GRANT pg_read_all_data TO arda_agent_ro;
#   ALTER ROLE arda_agent_ro SET default_transaction_read_only = on;
#   ALTER ROLE arda_agent_ro SET statement_timeout = '15s';
#   ALTER ROLE arda_agent_ro SET idle_in_transaction_session_timeout = '60s';
#   GRANT CONNECT ON DATABASE <db> TO arda_agent_ro;   -- repeat per service DB
#
# Do NOT put an application DSN here: app roles (arda_*) can write. Details:
# arda-infra/docs/agent-access.md
ARDA_AGENT_RO_USER=arda_agent_ro
ARDA_AGENT_RO_PASSWORD=<read-only-role-password>
POSTGRES_HOST=192.168.10.201
POSTGRES_PORT=30432
# Optional: restrict which databases the MCP exposes (default: all 18 service DBs).
# POSTGRES_DATABASES=iam,finance,loan,workflow,ai,platform

# ---------------------------------------------------------------------------
# Write role for the postgres-admin MCP (`-Write`): data cleanup only.
# DML grants, NOT a table owner; no DDL; goose_db_version and the auth
# databases (hydra/kratos/zitadel) stay off-limits. Provision / rotate with:
#
#   CREATE ROLE arda_agent_rw WITH LOGIN PASSWORD '<password>';  -- or ALTER ROLE
#   ALTER ROLE arda_agent_rw SET statement_timeout = '15s';
#   ALTER ROLE arda_agent_rw SET idle_in_transaction_session_timeout = '30s';
#   GRANT CONNECT ON DATABASE <db> TO arda_agent_rw;             -- per writable DB
#   -- then per DB (connected to it), as superuser:
#   GRANT USAGE ON SCHEMA public TO arda_agent_rw;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO arda_agent_rw;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO arda_agent_rw;
#   REVOKE ALL ON TABLE public.goose_db_version FROM arda_agent_rw;
#   ALTER DEFAULT PRIVILEGES FOR ROLE <owner> IN SCHEMA public
#     GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO arda_agent_rw;
#   ALTER DEFAULT PRIVILEGES FOR ROLE <owner> IN SCHEMA public
#     GRANT USAGE, SELECT ON SEQUENCES TO arda_agent_rw;
#
# Never grant ownership/DDL: schema changes belong to Goose migrations.
ARDA_AGENT_RW_USER=arda_agent_rw
ARDA_AGENT_RW_PASSWORD=<write-role-password>
